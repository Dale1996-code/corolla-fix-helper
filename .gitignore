node_modules/
client/node_modules/
server/node_modules/
client/dist/
server/dist/
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/diagnostics/
# What a restore leaves beside the live data: the previous database (and its
# sidecars) under pre-restore-*/, the previous uploads folder, and the staged
# copies that exist only while a restore runs. Each is a full copy of the
# database or of every uploaded PDF, and even a failed restore leaves one behind.
server/data/pre-restore-*/
server/data/*.db.restore-*
server/uploads.pre-restore-*/
server/uploads.restore-*/
server/uploads/*
!server/uploads/.gitkeep
.env
.DS_Store
desktop.ini
*.log

# Generated Claude skill eval/benchmark output and MCP snapshots (not app code).
# The real skill source under .claude/skills/<name>/ stays tracked; only the
# generated *-workspace eval runs and Playwright MCP snapshots are excluded.
.claude/skills/*-workspace/
.playwright-mcp/

# N5 blind applicability labels quote real manual text; never commit them.
server/data/applicability-labels/
