NODE_ENV=development
PORT=4000
CLIENT_PORT=5173
CORS_ORIGIN=http://localhost:5173
DATABASE_FILE=./data/corolla-fix-helper.db
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
# Bind to localhost only by default. Set NETWORK_MODE=1 to listen on all
# interfaces for phone/LAN/Tailscale access (see docs/mobile-access.md). The
# backup export stays loopback-only regardless.
NETWORK_MODE=0
OPENAI_API_KEY=
# Pinned snapshot, not a floating model alias: an alias changes model
# behavior underneath the eval suite, so a regression becomes indistinguishable
# from a model update. Move it deliberately.
OPENAI_ANSWER_MODEL=gpt-5.5-2026-04-23
# Reasoning-family models (gpt-5*, o-series) REJECT `temperature` outright, so
# the app omits it for them and sends reasoning.effort instead -- see
# server/src/services/openAiModelCapabilities.js. Accepted values: none, low,
# medium, high, xhigh, max. Default "low": this app quotes and checks source
# text rather than solving problems, and reasoning tokens are billed against
# OPENAI_MAX_OUTPUT_TOKENS, so a high effort can truncate the answer.
OPENAI_REASONING_EFFORT=low
# Accidental-spend guards (single-user app; not abuse defense). Cap tokens per
# model reply, abort a stalled stream after N ms of silence, and a coarse daily
# ceiling on model calls as a runaway-loop backstop (0 disables it).
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_STREAM_IDLE_TIMEOUT_MS=30000
AI_DAILY_CALL_LIMIT=500
# Model used only when an Ask request includes a saved image attachment.
# Leave blank to reuse OPENAI_ANSWER_MODEL.
OPENAI_VISION_MODEL=
# Dev-only Ask visibility. When true, Ask attaches a log-safe metrics object
# (durations, counts, sizes, numeric IDs — never document text) to the service
# result and the /api/ask response, and `npm run eval:answers` prints per-case
# timings. Off by default so the response shape is unchanged in normal use.
ASK_DEBUG_METRICS=false
# Optional LLM reranker over hybrid Ask retrieval. Off by default; when true it
# reorders a wider candidate pool before the final result slice. Needs an API key.
# Ask evidence contract. On by default. Ask asks the model for atomic
# claims each carrying a verbatim quote, verifies every quote against the cited
# chunk server-side, checks technical numbers and recognized torque subjects,
# and derives answered/partial/not_found itself. Only passages that actually
# backed a verified claim are cited. Set false only for legacy compatibility;
# legacy prose is labeled unverified and retrieved passages are not citations.
ASK_EVIDENCE_CONTRACT=true

RERANK_ENABLED=false
RERANK_CANDIDATE_LIMIT=20
# Model used by the reranker. Leave blank to reuse OPENAI_ANSWER_MODEL.
OPENAI_RERANK_MODEL=

# Result diversity. The most chunks one LOGICAL SOURCE may contribute to a single
# retrieval result set, where a source is a content group: documents holding
# identical extracted text share one budget, so a duplicated PDF cannot spend it
# several times over. Applied after ranking (and after any reranking), so it only
# ever selects -- it never reorders and never demotes the top result. Chunks the
# cap holds back backfill any slot it leaves empty, so a question whose only
# evidence lives in one document still returns a full result set.
# 3, not 1: a torque figure routinely spans two overlapping chunks of one page
# and a bleeding procedure spans three, so a smaller cap cuts real evidence.
# 0 disables the safeguard and restores the plain ranked slice.
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_EMBEDDING_BATCH_SIZE=64
OCR_ENABLED=true
OCR_MIN_TEXT_CHARACTERS=20
OCR_DPI=300
OCR_LANGUAGE=eng
OCR_TESSERACT_COMMAND=tesseract
OCR_PDFTOPPM_COMMAND=pdftoppm
