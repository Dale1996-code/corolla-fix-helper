{
  "name": "corolla-fix-helper",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first repair helper for a 2009 Toyota Corolla LE 1.8L",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "import": "npm --prefix server run import --",
    "demo:seed": "npm --prefix server run demo:seed",
    "restore": "npm --prefix server run restore --",
    "backup:drill": "npm --prefix server run backup:drill",
    "embed:backfill": "npm --prefix server run embed:backfill",
    "eval:retrieval": "npm --prefix server run eval:retrieval",
    "eval:rerank": "npm --prefix server run eval:rerank",
    "eval:answers": "npm --prefix server run eval:answers",
    "lint": "eslint server && npm --prefix client run lint",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "typecheck": "tsc --project tsconfig.changed.json --noEmit",
    "start": "npm --prefix server run start",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3"
  }
}
