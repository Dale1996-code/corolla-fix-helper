+test("sort_maintenance_schedule classifies active symptoms as now and routine jobs as defer", () => {
+  const tasks = [
+    {
+      id: 1,
+      title: "Front brakes squeak when stopping",
+      system: "Brakes",
+      difficulty: "intermediate",
+      safetyFlags: ["Brake work affects stopping safety."],
+    },
+    {
+      id: 2,
+      title: "Replace cabin air filter per service interval",
+      system: "HVAC",
+      difficulty: "beginner",
+      safetyFlags: [],
+    },
+  ];
+
+  const { schedule } = sortMaintenanceSchedule({ tasks });
+
+  assert.ok(Array.isArray(schedule.now), "now bucket should be an array");
+  assert.ok(Array.isArray(schedule.defer), "defer bucket should be an array");
+
+  const nowIds = schedule.now.map((entry) => entry.taskId);
+  const deferIds = schedule.defer.map((entry) => entry.taskId);
+
+  assert.ok(nowIds.includes(1), "brake task with safety flag should be in now bucket");
+  assert.ok(deferIds.includes(2), "routine filter replacement should be in defer bucket");
+
+  const nowEntry = schedule.now.find((entry) => entry.taskId === 1);
+  assert.ok(nowEntry.rationale, "each now entry should have a rationale string");
+  assert.equal(nowEntry.bucket, "now");
+
+  const deferEntry = schedule.defer.find((entry) => entry.taskId === 2);
+  assert.ok(deferEntry.rationale, "each defer entry should have a rationale string");
+  assert.equal(deferEntry.bucket, "defer");
+});
+
+test("sort_maintenance_schedule returns empty buckets for an empty task list", () => {
+  const { schedule } = sortMaintenanceSchedule({ tasks: [] });
+
+  assert.deepEqual(schedule.now, []);
+  assert.deepEqual(schedule.defer, []);
+});
+
