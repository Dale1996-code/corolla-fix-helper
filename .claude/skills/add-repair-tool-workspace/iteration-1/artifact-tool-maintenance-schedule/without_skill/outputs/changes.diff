+// --- Tool: sort_maintenance_schedule --------------------------------------
+
+// Urgency signals: keywords that indicate a task should not be deferred.
+const NOW_TERMS = [
+  "squeak", "squeal", "grind", "leak", "smoke", "overheat", "warning light",
+  "check engine", "stall", "misfire", "vibrat", "pull", "brake", "abs",
+  "loss of power", "no start", "won't start", "dead", "flat",
+];
+
+// Interval cues suggesting a task can wait for a scheduled appointment.
+const DEFER_TERMS = [
+  "scheduled", "service interval", "miles", "flush", "cabin filter",
+  "air filter", "wiper", "tire rotation", "coolant flush", "transmission fluid",
+  "differential", "spark plug", "belt", "replace", "routine",
+];
+
+function classifyUrgency(task) {
+  const lowered = (task.title + " " + (task.system || "")).toLowerCase();
+
+  const nowScore = NOW_TERMS.filter((term) => lowered.includes(term)).length;
+  const deferScore = DEFER_TERMS.filter((term) => lowered.includes(term)).length;
+
+  // Safety-critical tasks are always "do now".
+  if (Array.isArray(task.safetyFlags) && task.safetyFlags.length > 0) {
+    return "now";
+  }
+
+  if (nowScore > 0 && nowScore >= deferScore) {
+    return "now";
+  }
+
+  return "defer";
+}
+
+function urgencyRationale(task, bucket) {
+  const lowered = (task.title + " " + (task.system || "")).toLowerCase();
+
+  if (bucket === "now") {
+    const matchedNow = NOW_TERMS.filter((term) => lowered.includes(term));
+    if (Array.isArray(task.safetyFlags) && task.safetyFlags.length > 0) {
+      return "Safety-critical — address before next drive.";
+    }
+    if (matchedNow.length) {
+      return `Active symptom detected (${matchedNow.slice(0, 2).join(", ")}) — address promptly.`;
+    }
+    return "Address promptly.";
+  }
+
+  const matchedDefer = DEFER_TERMS.filter((term) => lowered.includes(term));
+  if (matchedDefer.length) {
+    return `Routine maintenance (${matchedDefer.slice(0, 2).join(", ")}) — safe to schedule at next service.`;
+  }
+  return "No active symptom detected — safe to defer to the next scheduled service.";
+}
+
+export function sortMaintenanceSchedule({ tasks = [] } = {}) {
+  const now = [];
+  const defer = [];
+
+  for (const task of tasks) {
+    const bucket = classifyUrgency(task);
+    const rationale = urgencyRationale(task, bucket);
+
+    const entry = {
+      taskId: task.id,
+      task: task.title,
+      system: task.system || "General",
+      difficulty: task.difficulty || "beginner",
+      bucket,
+      rationale,
+    };
+
+    if (bucket === "now") {
+      now.push(entry);
+    } else {
+      defer.push(entry);
+    }
+  }
+
+  // Within each bucket, harder tasks surface first (more planning needed).
+  const byDifficulty = (left, right) =>
+    (DIFFICULTY_RANK[right.difficulty] || 1) - (DIFFICULTY_RANK[left.difficulty] || 1);
+
+  now.sort(byDifficulty);
+  defer.sort(byDifficulty);
+
+  return { schedule: { now, defer } };
+}
+
