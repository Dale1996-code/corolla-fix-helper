+// --- Tool: sort_maintenance_schedule --------------------------------------
+
+// Systems where deferred work is genuinely dangerous or will cause secondary
+// damage quickly if left alone. Everything else can wait.
+const URGENT_SYSTEMS = new Set(["Brakes", "Cooling", "Fuel", "Electrical"]);
+
+// The schedule bucket each urgency level maps to.
+const BUCKET_DO_NOW = "do_now";
+const BUCKET_CAN_WAIT = "can_wait";
+
+/**
+ * Returns the urgency tier for a single task: "critical", "soon", or "routine".
+ * critical → safety-flagged or a system that cannot be safely deferred
+ * soon     → intermediate difficulty or an urgent-but-unflagged system
+ * routine  → beginner tasks on non-critical systems
+ */
+function classifyUrgency(task) {
+  const hasSafetyFlags = Array.isArray(task.safetyFlags) && task.safetyFlags.length > 0;
+  const isUrgentSystem = URGENT_SYSTEMS.has(task.system);
+  const difficulty = DIFFICULTY_RANK[task.difficulty] ? task.difficulty : "beginner";
+
+  if (hasSafetyFlags || (isUrgentSystem && difficulty === "beginner")) {
+    return "critical";
+  }
+  if (isUrgentSystem || difficulty === "intermediate") {
+    return "soon";
+  }
+  return "routine";
+}
+
+/**
+ * Sorts extracted tasks into a two-bucket maintenance schedule: tasks to do now
+ * and tasks that can safely wait. Pure function of its input — no randomness,
+ * no clock, no network. Returns an empty schedule instead of throwing when
+ * tasks is missing or malformed.
+ */
+export function sortMaintenanceSchedule({ tasks = [] } = {}) {
+  const doNow = [];
+  const canWait = [];
+
+  for (const task of tasks) {
+    const urgency = classifyUrgency(task);
+    const scheduled = {
+      taskId: task.id,
+      task: task.title,
+      system: task.system,
+      difficulty: task.difficulty,
+      urgency,
+      bucket: urgency === "routine" ? BUCKET_CAN_WAIT : BUCKET_DO_NOW,
+      reason:
+        urgency === "critical"
+          ? "Safety-critical or system failure risk — address before driving."
+          : urgency === "soon"
+            ? "System is safety-relevant or task difficulty warrants prompt attention."
+            : "Routine maintenance; safe to schedule at your convenience.",
+    };
+
+    if (scheduled.bucket === BUCKET_DO_NOW) {
+      doNow.push(scheduled);
+    } else {
+      canWait.push(scheduled);
+    }
+  }
+
+  // Within each bucket: critical before soon, then by taskId for stable ordering.
+  const urgencyOrder = { critical: 0, soon: 1, routine: 2 };
+  doNow.sort(
+    (a, b) => (urgencyOrder[a.urgency] ?? 2) - (urgencyOrder[b.urgency] ?? 2) || a.taskId - b.taskId
+  );
+  canWait.sort((a, b) => a.taskId - b.taskId);
+
+  return { doNow, canWait };
+}
