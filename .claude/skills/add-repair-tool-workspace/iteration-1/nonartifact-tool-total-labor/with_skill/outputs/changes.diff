+// --- Tool: total_labor_hours ----------------------------------------------
+
+const LABOR_HOURS_BY_DIFFICULTY = { beginner: 1, intermediate: 2.5, advanced: 5 };
+
+export function totalLaborHours({ tasks = [] } = {}) {
+  const breakdown = tasks.map((task) => {
+    const difficulty = DIFFICULTY_RANK[task.difficulty] ? task.difficulty : "beginner";
+    const hours = LABOR_HOURS_BY_DIFFICULTY[difficulty];
+
+    return {
+      taskId: task.id,
+      task: task.title,
+      difficulty,
+      estimatedHours: hours,
+    };
+  });
+
+  const totalHours = breakdown.reduce((sum, line) => sum + line.estimatedHours, 0);
+
+  return { breakdown, totalHours };
+}
