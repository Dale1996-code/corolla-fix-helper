+test("total_labor_hours sums estimated hours by difficulty", () => {
+  const { breakdown, totalHours } = totalLaborHours({
+    tasks: [
+      { id: 1, title: "Replace cabin filter", difficulty: "beginner" },
+      { id: 2, title: "Replace front struts", difficulty: "intermediate" },
+      { id: 3, title: "Replace timing chain", difficulty: "advanced" },
+    ],
+  });
+
+  assert.equal(breakdown.length, 3);
+  assert.equal(breakdown[0].estimatedHours, 1);
+  assert.equal(breakdown[1].estimatedHours, 2.5);
+  assert.equal(breakdown[2].estimatedHours, 5);
+  // 1 + 2.5 + 5 = 8.5
+  assert.equal(totalHours, 8.5);
+});
+
+test("total_labor_hours handles empty tasks and unknown difficulty gracefully", () => {
+  const empty = totalLaborHours();
+  assert.equal(empty.breakdown.length, 0);
+  assert.equal(empty.totalHours, 0);
+
+  const unknown = totalLaborHours({ tasks: [{ id: 1, title: "Mystery job", difficulty: "unknown" }] });
+  assert.equal(unknown.breakdown[0].estimatedHours, 1); // falls back to beginner
+  assert.equal(unknown.totalHours, 1);
+});
+
