+// --- Tool: estimate_labor_hours -------------------------------------------
+
+// Base labor-hour estimates by difficulty tier.  These are rough DIY-bench
+// figures for a home mechanic — not flat-rate shop hours.  The model uses the
+// totals to set expectations in its narrative ("budget a full weekend") and to
+// flag when a job will run longer than a Saturday afternoon.
+const BASE_HOURS_BY_DIFFICULTY = {
+  beginner: 1.0,
+  intermediate: 2.5,
+  advanced: 5.0,
+};
+
+// Per-system adjustments that add time on top of the difficulty base.
+const SYSTEM_HOUR_ADJUSTMENTS = {
+  Transmission: 2.0,
+  Engine: 1.5,
+  Cooling: 0.5,
+  Electrical: 0.5,
+  Suspension: 0.5,
+  Brakes: 0.25,
+  HVAC: 0.25,
+  Fuel: 0.5,
+  General: 0,
+};
+
+export function estimateLaborHours({ tasks = [] } = {}) {
+  if (!tasks.length) {
+    return { totalHours: 0, breakdown: [] };
+  }
+
+  const breakdown = tasks.map((task) => {
+    const base = BASE_HOURS_BY_DIFFICULTY[task.difficulty] ?? BASE_HOURS_BY_DIFFICULTY.beginner;
+    const systemAdj = SYSTEM_HOUR_ADJUSTMENTS[task.system] ?? 0;
+    const hours = Math.round((base + systemAdj) * 10) / 10;
+
+    return {
+      taskId: task.id,
+      task: task.title,
+      system: task.system ?? "General",
+      difficulty: task.difficulty ?? "beginner",
+      estimatedHours: hours,
+    };
+  });
+
+  const totalHours = Math.round(breakdown.reduce((sum, item) => sum + item.estimatedHours, 0) * 10) / 10;
+
+  return { totalHours, breakdown };
+}
+
