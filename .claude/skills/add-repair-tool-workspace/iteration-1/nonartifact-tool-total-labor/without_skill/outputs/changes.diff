+test("estimate_labor_hours totals hours across tasks and returns a per-task breakdown", () => {
+  const tasks = [
+    { id: 1, title: "Replace front brake pads", system: "Brakes", difficulty: "beginner" },
+    { id: 2, title: "Replace alternator", system: "Electrical", difficulty: "intermediate" },
+  ];
+
+  const result = estimateLaborHours({ tasks });
+
+  assert.equal(result.breakdown.length, 2);
+  // beginner Brakes: 1.0 + 0.25 = 1.25
+  assert.equal(result.breakdown[0].estimatedHours, 1.25);
+  assert.equal(result.breakdown[0].taskId, 1);
+  // intermediate Electrical: 2.5 + 0.5 = 3.0
+  assert.equal(result.breakdown[1].estimatedHours, 3.0);
+  assert.equal(result.breakdown[1].taskId, 2);
+  // total: 1.25 + 3.0 = 4.25
+  assert.equal(result.totalHours, 4.25);
+});
+
+test("estimate_labor_hours returns zero totals for an empty task list", () => {
+  const result = estimateLaborHours({ tasks: [] });
+
+  assert.equal(result.totalHours, 0);
+  assert.deepEqual(result.breakdown, []);
+});
+
+test("estimate_labor_hours defaults gracefully when difficulty or system are unknown", () => {
+  const tasks = [{ id: 1, title: "Mystery job", system: "Unknown", difficulty: "unknown" }];
+  const result = estimateLaborHours({ tasks });
+
+  // Unknown difficulty falls back to beginner (1.0), unknown system adjustment is 0.
+  assert.equal(result.breakdown[0].estimatedHours, 1.0);
+  assert.equal(result.totalHours, 1.0);
+});
+
