+// --- lookup_torque_spec tool tests -----------------------------------------
+
+const mockTorqueRetrieve = () => [
+  {
+    documentId: 7,
+    pageNumber: 4,
+    chunkIndex: 1,
+    chunkText: "Front brake caliper bolt: torque to 25 ft-lb. Rear caliper bolt: torque to 34 Nm.",
+    documentTitle: "Brake Service Guide",
+    originalFilename: "brake-guide.pdf",
+  },
+];
+
+const mockNoTorqueRetrieve = () => [
+  {
+    documentId: 2,
+    pageNumber: 1,
+    chunkIndex: 0,
+    chunkText: "General brake inspection procedure. Check pad thickness.",
+    documentTitle: "Maintenance Manual",
+    originalFilename: "maintenance.pdf",
+  },
+];
+
+test("lookup_torque_spec returns matches and extracted torque values when present in chunks", () => {
+  const result = lookupTorqueSpec({ part: "caliper bolt" }, { retrieve: mockTorqueRetrieve });
+
+  assert.equal(result.part, "caliper bolt");
+  assert.equal(result.found, true);
+  assert.equal(result.matches.length, 1);
+  assert.equal(result.matches[0].documentId, 7);
+  assert.equal(result.matches[0].pageNumber, 4);
+  assert.ok(result.matches[0].torqueValues.includes("25 ft-lb"), "expected 25 ft-lb in torque values");
+  assert.ok(result.matches[0].torqueValues.includes("34 Nm"), "expected 34 Nm in torque values");
+  assert.match(result.matches[0].snippet, /caliper bolt/);
+});
+
+test("lookup_torque_spec returns found:false when no chunk contains a torque value", () => {
+  const result = lookupTorqueSpec({ part: "brake pad" }, { retrieve: mockNoTorqueRetrieve });
+
+  assert.equal(result.part, "brake pad");
+  assert.equal(result.found, false);
+  assert.equal(result.matches.length, 0);
+});
+
+test("lookup_torque_spec returns empty result for blank part", () => {
+  const result = lookupTorqueSpec({ part: "  " }, { retrieve: mockTorqueRetrieve });
+
+  assert.equal(result.part, "");
+  assert.equal(result.found, false);
+  assert.deepEqual(result.matches, []);
+});
+
+test("lookup_torque_spec handles missing part parameter gracefully", () => {
+  const result = lookupTorqueSpec({}, { retrieve: mockTorqueRetrieve });
+
+  assert.equal(result.found, false);
+  assert.deepEqual(result.matches, []);
+});
+
+test("lookup_torque_spec accumulates torqueSpecs artifact in the agent loop", async () => {
+  const torqueStreamTurn = async function* () {
+    yield {
+      type: "function_call",
+      callId: "call_torque",
+      name: "lookup_torque_spec",
+      arguments: { part: "caliper bolt" },
+    };
+    yield { type: "text_delta", text: "Caliper bolt torque is 25 ft-lb per the manual." };
+  };
+
+  const events = [];
+  const result = await runRepairPlannerAgent(
+    { brief: "Replace front brake pads. Torque the caliper bolts." },
+    {
+      emit: (event) => events.push(event),
+      streamTurn: torqueStreamTurn,
+      retrieve: mockTorqueRetrieve,
+      isAiConfigured: true,
+    }
+  );
+
+  assert.equal(result.status, "completed");
+  assert.equal(result.artifacts.torqueSpecs.length, 1);
+  assert.equal(result.artifacts.torqueSpecs[0].part, "caliper bolt");
+  assert.equal(result.artifacts.torqueSpecs[0].found, true);
+
+  const toolResultEvent = events.find(
+    (e) => e.type === "tool_result" && e.name === "lookup_torque_spec"
+  );
+  assert.ok(toolResultEvent, "expected a tool_result event for lookup_torque_spec");
+  assert.match(toolResultEvent.summary, /25 ft-lb/);
+});
