+// --- Tool: lookup_torque_spec ---------------------------------------------
+
+// Patterns that identify torque-spec content in a chunk.
+// We look for values like "25 ft-lb", "35 Nm", "10–12 ft·lbf", etc.
+const TORQUE_PATTERN =
+  /\b\d[\d.,–\-]*\s*(?:ft[\s·\-]?lb[sf]?|foot[\s\-]?pound[s]?|n[\s·\-]?m|newton[\s\-]?met(?:er|re)[s]?)\b/i;
+
+function extractTorqueValues(text) {
+  const matches = text.match(
+    /\b\d[\d.,–\-]*\s*(?:ft[\s·\-]?lb[sf]?|foot[\s\-]?pound[s]?|n[\s·\-]?m|newton[\s\-]?met(?:er|re)[s]?)\b/gi
+  );
+
+  return matches ? [...new Set(matches.map((m) => m.trim()))] : [];
+}
+
+export function lookupTorqueSpec(
+  { part, limit = 4 } = {},
+  { retrieve = retrieveRelevantChunks } = {}
+) {
+  const normalizedPart = normalizeText(part);
+
+  if (!normalizedPart) {
+    return { part: "", matches: [], found: false };
+  }
+
+  // Append "torque spec" so the retriever surfaces torque-heavy chunks.
+  const query = `${normalizedPart} torque spec`;
+  const chunks = retrieve(query, { limit });
+
+  // Filter to chunks that actually contain a torque value.
+  const torqueChunks = chunks.filter((chunk) =>
+    TORQUE_PATTERN.test(chunk.chunkText || "")
+  );
+
+  const matches = torqueChunks.map((chunk) => ({
+    documentId: chunk.documentId,
+    documentTitle: chunk.documentTitle,
+    originalFilename: chunk.originalFilename,
+    pageNumber: chunk.pageNumber,
+    chunkIndex: chunk.chunkIndex,
+    snippet: buildSnippet(chunk.chunkText),
+    torqueValues: extractTorqueValues(chunk.chunkText || ""),
+  }));
+
+  return { part: normalizedPart, matches, found: matches.length > 0 };
+}
+
